# WordPress REST API for this app (from the Code Snippets backend in backend/).
# Replace your-wordpress-site.com with your site. Works with ANY permalink setting,
# including "Plain" – no need to change permalinks.
VITE_API_URL=https://your-wordpress-site.com/?rest_route=/srivalli/v1

# If your site uses pretty permalinks you can also use:
# VITE_API_URL=https://your-wordpress-site.com/wp-json/srivalli/v1
